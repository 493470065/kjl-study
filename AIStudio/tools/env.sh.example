#!/bin/bash
# RACC 平台构建/运行环境（Git Bash 用）
export JAVA_HOME="E:/KjlStudy/AI/kjl-study/AIStudio/tools/jdk-17.0.20+8"
export PATH="$JAVA_HOME/bin:$PATH"
export MVN_CMD="E:/KjlStudy/AI/kjl-study/AIStudio/tools/apache-maven-3.9.16/bin/mvn.cmd"
# bash 里 mvn.cmd 需要 JAVA_HOME 为 Windows 风格路径
export JAVA_HOME_WIN='E:\KjlStudy\AI\kjl-study\AIStudio\tools\jdk-17.0.20+8'

# ===== LLM 环境配置（与 env.cmd 保持一致：WinCode 网关，OpenAI 兼容）=====
export LLM_API_KEY="sk-your-api-key-here"
export LLM_BASE_URL="https://wincode.winning.com.cn/ai"
export LLM_MODEL="glm-5"
export LLM_ENABLED="true"
# embedding 端点 WinCode 网关未实现，保持禁用（平台自动降级为关键词检索）
export LLM_EMBEDDING_ENABLED="false"
export LLM_EMBEDDING_MODEL="text-embedding-3-small"
