@echo off
REM RACC 平台构建/运行环境（JDK17 + Maven）
REM 用法：call env.cmd 之后同窗口使用 java / mvn
set "JAVA_HOME=%~dp0jdk-17.0.20+8"
set "MAVEN_HOME=%~dp0apache-maven-3.9.16"
set "PATH=%JAVA_HOME%\bin;%MAVEN_HOME%\bin;%PATH%"

REM ===== LLM 环境变量（WinCode 公司网关，OpenAI 兼容）=====
REM chat 模型：glm-5（已验证网关可用，/v1/chat/completions）
set "LLM_API_KEY=sk-your-api-key-here"
set "LLM_BASE_URL=https://wincode.winning.com.cn/ai"
set "LLM_MODEL=glm-5"
REM 开启 chat（问答/对话）
set "LLM_ENABLED=true"
REM 关闭 embedding 端点（当前 WinCode 网关未实现 /v1/embeddings，验证过 not implemented）
REM 无 embedding 时平台自动降级为关键词检索，如需向量检索可将开关置 true
set "LLM_EMBEDDING_ENABLED=false"
set "LLM_EMBEDDING_MODEL=text-embedding-3-small"